# Xcode build output
build/
DerivedData/
*.xcresult
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Xcode per-user state. The shared scheme in xcshareddata/ stays tracked.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager. Package.resolved stays tracked once there are
# dependencies, so every build gets the same versions.
.build/
.swiftpm/

# Fastlane, if it's ever added
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# Signing and App Store credentials: each developer keeps their own, and
# none of them belong in a public repo
Signing.local.xcconfig
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.p8
AuthKey_*.p8
.env
.env.*

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp
*~

# Local tool settings
.claude/settings.local.json
.claude/tackline/
