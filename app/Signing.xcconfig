// Code signing for builds from the Xcode project: automatic signing, set up
// the way Xcode sets up a new iPhone app. Simulator builds need no team.
//
// Leave this file as it is. To run on your own iPhone, or to archive for the
// App Store, copy Signing.local.xcconfig.example to Signing.local.xcconfig,
// which git ignores, and put in your team ID. See CONTRIBUTING.md.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// Private Cloud Compute needs a managed entitlement that Apple assigns to a
// developer account, and calling the model without it crashes the app. So
// the code that calls it compiles in only when Signing.local.xcconfig sets
// SHUTTERDROP_PCC = PRIVATE_CLOUD_COMPUTE and points CODE_SIGN_ENTITLEMENTS at
// ShutterDrop.entitlements. See RELEASING.md.
SHUTTERDROP_PCC =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(SHUTTERDROP_PCC)

#include? "Signing.local.xcconfig"
